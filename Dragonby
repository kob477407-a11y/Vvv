local MainTab = Window:CreateTab("Auto Farm", 4483362458)
local Section = MainTab:CreateSection("Chest Farm")

_G.AutoChest = false

-- HÀM BAY MƯỢT (BYPASS ANTI-CHEAT)
local function SmoothTP(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local distance = (root.Position - targetCFrame.p).Magnitude
        -- Tốc độ 300-350 là cực nhanh nhưng không bị văng game
        local info = TweenInfo.new(distance / 320, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(root, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- NÚT BẬT/TẮT RAYFIELD
MainTab:CreateToggle({
   Name = "Auto Farm Rương (Mượt)",
   CurrentValue = false,
   Flag = "ChestToggle",
   Callback = function(Value)
      _G.AutoChest = Value
      if Value then
         spawn(function()
            while _G.AutoChest do
               task.wait(0.1)
               pcall(function()
                  local target = nil
                  -- Quét tìm rương gần nhất
                  for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                     if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) and v.Transparency < 1 then
                        target = v
                        break
                     end
                  end

                  if target and _G.AutoChest then
                     local movement = SmoothTP(target.CFrame)
                     if movement then
                        movement.Completed:Wait() -- Chờ bay tới nơi
                        task.wait(0.3) -- Nghỉ một chút để nhận tiền
                     end
                  else
                      task.wait(1)
                  end
               end)
            end
         end)
      end
   end,
})

