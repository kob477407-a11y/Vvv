-- [[ DRAGON HUB V10 - FIX LỖI KHÔNG NHẶT RƯƠNG ]]
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

local Window = OrionLib:MakeWindow({
    Name = "DRAGON HUB V10", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "DragonV10",
    IntroText = "Đang khởi động Dragon Hub..."
})

local MainTab = Window:MakeTab({
	Name = "Auto Farm",
	Icon = "rbxassetid://4483362458",
	PremiumOnly = false
})

_G.AutoChest = false

-- HÀM DI CHUYỂN SIÊU TỐC (BYPASS ANTI-CHEAT)
local function SmoothTP(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local distance = (root.Position - targetCFrame.p).Magnitude
        -- Tăng tốc độ lên 380 để nhặt cho nhanh
        local info = TweenInfo.new(distance / 380, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(root, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- HÀM QUÉT RƯƠNG CHUẨN (FIX LỖI KHÔNG NHẶT)
function GetChest()
    for _, v in pairs(game:GetService("Workspace"):GetChildren()) do
        -- Kiểm tra tên rương chuẩn trong Blox Fruit
        if v:IsA("Part") or v:IsA("Model") then
            if v.Name:find("Chest") or v.Name:find("Rương") then
                -- Kiểm tra rương chưa bị nhặt (Transparency < 1)
                if v:FindFirstChild("TouchInterest") or v.Transparency < 1 then
                    return v
                end
            end
        end
    end
    -- Nếu không thấy ở ngoài, quét sâu hơn vào Descendants
    for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
        if v.Name:find("Chest") or v.Name:find("Rương") then
            if v:IsA("Part") and v.Transparency < 1 then
                return v
            end
        end
    end
    return nil
end

MainTab:AddToggle({
	Name = "Bắt Đầu Nhặt Rương",
	Default = false,
	Callback = function(Value)
		_G.AutoChest = Value
        if Value then
            spawn(function()
                while _G.AutoChest do
                    task.wait(0.1)
                    pcall(function()
                        local target = GetChest()
                        if target and _G.AutoChest then
                            local movement = SmoothTP(target.CFrame)
                            if movement then
                                movement.Completed:Wait() -- Đợi bay tới tận nơi
                                task.wait(0.2) -- Nghỉ 0.2s để game kịp cộng tiền
                            end
                        else
                            -- Nếu hết rương thì đứng đợi 2s rồi quét tiếp
                            task.wait(2)
                        end
                    end)
                end
            end)
        end
	end    
})

OrionLib:Init()
