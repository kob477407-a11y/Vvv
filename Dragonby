-- [[ DRAGON HUB V10 - ANTI-STUCK & FAST CHEST ]]
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

local Window = OrionLib:MakeWindow({
    Name = "DRAGON HUB V10", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "DragonV10",
    IntroText = "Fixing Iron Block Mode..."
})

local MainTab = Window:MakeTab({
	Name = "Auto Farm",
	Icon = "rbxassetid://4483362458",
	PremiumOnly = false
})

_G.AutoChest = false

-- HÀM XUYÊN TƯỜNG (ĐỂ KHÔNG BỊ KẸT KHI BAY)
spawn(function()
    game:GetService("RunService").Stepped:Connect(function()
        if _G.AutoChest then
            for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)
end)

-- HÀM BAY SIÊU MƯỢT
local function SmoothTP(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local distance = (root.Position - targetCFrame.p).Magnitude
        local speed = 350 
        local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(root, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- BỘ QUÉT RƯƠNG ƯU TIÊN KHOẢNG CÁCH
function GetChest()
    local target = nil
    local dist = math.huge
    for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
        if (v.Name:find("Chest") or v.Name:find("Rương")) and v:IsA("TouchTransmitter") then
            local chest = v.Parent
            if chest and chest:IsA("BasePart") and chest.Transparency < 1 then
                local mag = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - chest.Position).Magnitude
                if mag < dist then
                    dist = mag
                    target = chest
                end
            end
        end
    end
    return target
end

MainTab:AddToggle({
	Name = "Bắt đầu nhặt rương (Fix Stuck)",
	Default = false,
	Callback = function(Value)
		_G.AutoChest = Value
        if Value then
            spawn(function()
                while _G.AutoChest do
                    task.wait(0.1)
                    pcall(function()
                        local target = GetChest()
                        if target and _G.AutoChest then
                            local movement = SmoothTP(target.CFrame)
                            if movement then
                                movement.Completed:Wait()
                                task.wait(0.2)
                            end
                        else
                            -- Nếu đứng im, thử nhảy lên để reset vị trí
                            game.Players.LocalPlayer.Character.Humanoid.Jump = true
                            task.wait(2)
                        end
                    end)
                end
            end)
        end
	end    
})

OrionLib:Init()
