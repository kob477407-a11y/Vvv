-- [[ DRAGON HUB V10 - SOURCE CHUẨN ]]
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

-- 1. TẠO GIAO DIỆN (Nếu chưa có)
if not CoreGui:FindFirstChild("DragonHub_V10") then
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DragonHub_V10"
    ScreenGui.Parent = CoreGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 350, 0, 220)
    MainFrame.Position = UDim2.new(0.5, -175, 0.5, -110)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 15)
    UICorner.Parent = MainFrame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(255, 0, 0)
    UIStroke.Thickness = 2
    UIStroke.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 50)
    Title.Text = "DRAGON HUB V10"
    Title.TextColor3 = Color3.fromRGB(255, 40, 40)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 24
    Title.BackgroundTransparency = 1
    Title.Parent = MainFrame

    local Credits = Instance.new("TextLabel")
    Credits.Size = UDim2.new(1, 0, 0, 20)
    Credits.Position = UDim2.new(0, 0, 0, 45)
    Credits.Text = "BY DRAGON"
    Credits.TextColor3 = Color3.fromRGB(200, 200, 200)
    Credits.Font = Enum.Font.Code
    Credits.TextSize = 13
    Credits.BackgroundTransparency = 1
    Credits.Parent = MainFrame

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = "ActivateButton"
    ToggleBtn.Size = UDim2.new(0, 280, 0, 55)
    ToggleBtn.Position = UDim2.new(0.5, -140, 0.6, 10)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    ToggleBtn.Text = "KÍCH HOẠT FARM"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.TextSize = 20
    ToggleBtn.Parent = MainFrame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 12)
    BtnCorner.Parent = ToggleBtn

    -- LOGIC FARM KHI BẤM NÚT
    _G.AutoFarm = false
    ToggleBtn.MouseButton1Click:Connect(function()
        _G.AutoFarm = not _G.AutoFarm
        if _G.AutoFarm then
            ToggleBtn.Text = "ĐANG FARM..."
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            
            spawn(function()
                while _G.AutoFarm do
                    task.wait(0.1)
                    -- Logic quét rương
                    for _, v in pairs(game.Workspace:GetDescendants()) do
                        if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) and v.Transparency == 0 then
                            if Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
                                task.wait(0.3)
                            end
                        end
                    end
                end
            end)
        else
            ToggleBtn.Text = "KÍCH HOẠT FARM"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        end
    end)
end
