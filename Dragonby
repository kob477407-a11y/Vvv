local MainTab = Window:CreateTab("Auto Farm", 4483362458) -- Icon Farm
local Section = MainTab:CreateSection("Chest Farm (Nhặt rương)")

_G.AutoChest = false

-- Hàm di chuyển mượt (Tween) để không bị Anti-cheat đứng im
local function SmoothTP(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local distance = (root.Position - targetCFrame.p).Magnitude
        local speed = 350 -- Tốc độ bay (Dưới 350 là cực kỳ an toàn)
        local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(root, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- Nút gạt bật/tắt xịn xò
MainTab:CreateToggle({
   Name = "Tự động nhặt rương (All Sea)",
   CurrentValue = false,
   Flag = "ChestToggle",
   Callback = function(Value)
      _G.AutoChest = Value
      if Value then
         spawn(function()
            while _G.AutoChest do
               task.wait(0.1)
               pcall(function()
                  local target = nil
                  -- Quét rương trong toàn bộ Workspace
                  for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                     if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) and v.Transparency < 1 then
                        target = v
                        break -- Ưu tiên tìm thấy cái nào đi cái đó luôn
                     end
                  end

                  if target then
                     local movement = SmoothTP(target.CFrame)
                     if movement then
                        movement.Completed:Wait() -- Đợi bay tới nơi mới nhặt rương tiếp
                        task.wait(0.2) -- Thời gian nghỉ để game nhận tiền
                     end
                  else
                      -- Nếu không có rương thì thông báo
                      print("Dragon Hub: Dang đợi rương hồi...")
                      task.wait(2)
                  end
               end)
            end
         end)
      end
   end,
})

