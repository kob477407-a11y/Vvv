-- 2. LOGIC FARM RUONG SIEU CAP
_G.AutoChest = true

local function GetChest()
    -- Quét toàn bộ server để tìm rương
    for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
        if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) then
            if v.Transparency < 1 then -- Chỉ nhặt rương chưa ai lấy
                return v
            end
        end
    end
    return nil
end

spawn(function()
    while _G.AutoChest do
        task.wait(0.1)
        local p = game.Players.LocalPlayer
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if root then
            local target = GetChest()
            if target then
                -- Bay đến rương
                root.CFrame = target.CFrame
                task.wait(0.3) -- Đợi nhận tiền
            else
                -- Nếu hết rương thì đứng im đợi hoặc bạn có thể tự Server Hop
                print("Het ruong trong Server nay!")
                task.wait(2)
            end
        end
    end
end)
