local function GetChest()
    for _, v in pairs(game:GetService("Workspace"):GetChildren()) do
        if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) and v.Transparency == 0 then
            return v
        end
    end
    return nil
end

