local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 12)
BtnCorner.Parent = ToggleBtn

-- 5. LOGIC KHI BẤM NÚT
local isRunning = false
ToggleBtn.MouseButton1Click:Connect(function()
    if not isRunning then
        isRunning = true
        
        -- Hiệu ứng chuyển trạng thái
        ToggleBtn.Text = "ĐANG KẾT NỐI GITHUB..."
        TweenService:Create(ToggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(100, 0, 0)}):Play()

        -- Gọi Script từ link của bạn
        local success, err = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/kob477407-a11y/Vvv/refs/heads/main/Dragonby"))()
        end)

        if success then
            ToggleBtn.Text = "ĐÃ KÍCH HOẠT THÀNH CÔNG!"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 70) -- Đổi sang xanh lá khi xong
            
            -- Thông báo nhỏ góc màn hình
            game.StarterGui:SetCore("SendNotification", {
                Title = "Dragon Hub V10",
                Text = "Script đã được tải từ GitHub!",
                Duration = 5
            })
        else
            -- Xử lý khi lỗi (Sai link hoặc GitHub lỗi)
            ToggleBtn.Text = "LỖI: KIỂM TRA LẠI LINK!"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
            warn("Loi load script tu GitHub: " .. tostring(err))
            wait(3)
            ToggleBtn.Text = "THỬ LẠI"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            isRunning = false
        end
    end
end)

print("Dragon Hub V10 Loader has been started!")
