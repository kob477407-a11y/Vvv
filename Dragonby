-- [[ DRAGON HUB V10 - FIX CHẠY 100% ]]
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

local Window = OrionLib:MakeWindow({
    Name = "DRAGON HUB V10", 
    HidePremium = false, 
    SaveConfig = true, 
    ConfigFolder = "DragonV10",
    IntroText = "Khởi động hệ thống quét..."
})

local MainTab = Window:MakeTab({
	Name = "Auto Farm",
	Icon = "rbxassetid://4483362458",
	PremiumOnly = false
})

_G.AutoChest = false

-- HÀM BAY MƯỢT (CHỐNG ANTI-CHEAT KHÓA VỊ TRÍ)
local function SmoothTP(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local distance = (root.Position - targetCFrame.p).Magnitude
        -- Tốc độ 350 là mức cực nhanh nhưng an toàn cho Sea 3
        local info = TweenInfo.new(distance / 350, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(root, info, {CFrame = targetCFrame})
        tween:Play()
        return tween
    end
end

-- HÀM TÌM RƯƠNG "CỰC MẠNH"
function GetChest()
    local target = nil
    local dist = math.huge
    -- Quét toàn bộ Descendants để chắc chắn không bỏ sót rương nào trong lâu đài hay hang động
    for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
        if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) and v.Transparency < 1 then
            local mag = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - v.Position).Magnitude
            if mag < dist then
                dist = mag
                target = v
            end
        end
    end
    return target
end

MainTab:AddToggle({
	Name = "Auto Farm Rương (Mượt)",
	Default = false,
	Callback = function(Value)
		_G.AutoChest = Value
        if Value then
            spawn(function()
                while _G.AutoChest do
                    task.wait(0.1)
                    pcall(function()
                        local chest = GetChest()
                        if chest and _G.AutoChest then
                            -- Bay đến rương gần nhất
                            local movement = SmoothTP(chest.CFrame)
                            if movement then
                                movement.Completed:Wait() -- Đợi bay tới nơi
                                task.wait(0.2) -- Nghỉ 0.2s để game nhận tiền
                            end
                        else
                            -- Nếu hết rương trong Server thì đổi Server (Server Hop) hoặc đợi
                            warn("Dragon Hub: Khong tim thay ruong, dang doi...")
                            task.wait(3)
                        end
                    end)
                end
            end)
        end
	end    
})

OrionLib:Init()
